{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chivo",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build:production"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
