---
import Base from '../layouts/Base.astro';
import { config } from '../config';
---
<Base title={`Página no encontrada — ${config.domain}`} noindex><header class="header wrap"><a class="wordmark" href="/">{config.domain}</a></header><main id="contenido" class="wrap document"><p class="eyebrow">ERROR 404</p><h1>No encontramos esta página.</h1><p>El enlace no existe o la página se ha movido.</p><a class="button" href="/">Volver al inicio <span aria-hidden="true">↗</span></a></main></Base>
